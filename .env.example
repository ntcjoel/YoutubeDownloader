# YouTube Downloader - Environment Variables Template
# Copy this file to .env and customize values.
# Environment variables take precedence over config.yaml

# Server binding (overrides config.yaml)
# HOST=0.0.0.0
# PORT=1917

# Directory paths (absolute paths recommended in Docker)
# VIDEO_DIR=/downloads/video
# MUSIC_DIR=/downloads/music

# Disk limits in GB (0 = unlimited)
# MAX_VIDEO_SIZE_GB=50
# MAX_MUSIC_SIZE_GB=10

# Cleanup policy: oldest_first or skip
# CLEANUP_POLICY=oldest_first

# Download defaults
# DEFAULT_QUALITY=1080p
# DEFAULT_FORMAT=video
# PLEX_COMPATIBLE=true

# History retention in days (0 = forever)
# RETENTION_DAYS=30
